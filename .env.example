# Local-only defaults. Never put real credentials in this repository.
# `make up` copies this file to `.env` if `.env` does not exist.

COMPOSE_PROJECT_NAME=de-lab

# Host ports. Change these if something else on your machine uses them.
POSTGRES_PORT=5432
SEAWEEDFS_S3_PORT=8333
SEAWEEDFS_MASTER_PORT=9333
LAKEKEEPER_PORT=8181
TRINO_PORT=8085
KAFKA_HOST_PORT=29092
KAFKA_CONNECT_PORT=8083
APICURIO_PORT=8086
KAFBAT_PORT=8081
FLINK_PORT=8082
DAGSTER_PORT=3002
VALKEY_PORT=6379
API_PORT=8001
GRAFANA_PORT=3001
PROMETHEUS_PORT=9090
MLFLOW_PORT=5001

# Application database.
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=app

# Lakekeeper catalog database. Created by the Postgres init scripts.
LAKEKEEPER_DB=lakekeeper
LAKEKEEPER_DB_USER=lakekeeper
LAKEKEEPER_DB_PASSWORD=lakekeeper
LAKEKEEPER_ENCRYPTION_KEY=lab-only-not-a-secret

# Dagster and MLflow metadata databases. Created by the Postgres init scripts.
DAGSTER_DB=dagster
DAGSTER_DB_USER=dagster
DAGSTER_DB_PASSWORD=dagster
MLFLOW_DB=mlflow
MLFLOW_DB_USER=mlflow
MLFLOW_DB_PASSWORD=mlflow

# S3-compatible object storage (SeaweedFS). Local development credentials only.
S3_BUCKET=lakehouse
S3_ACCESS_KEY=labadmin
S3_SECRET_KEY=labadmin123
S3_REGION=us-east-1

# Trino.
TRINO_USER=lab

# Generator defaults (used by Makefile targets and fixtures).
GENERATOR_SEED=1337
GENERATOR_RATE=2
GENERATOR_ATTACK_MIX=0.08
BACKFILL_DAYS=7
EVENTS_PER_DAY=2000

# Grafana local admin. Anonymous read is enabled by default.
GRAFANA_USER=admin
GRAFANA_PASSWORD=labadmin

# Minimum free RAM (GB) that `make doctor` requires. Individual profiles are
# much smaller; 8 GB is the brief's target for a full module.
LAB_MIN_FREE_GB=4

# UID/GID for files written into the bind-mounted repository.
LAB_UID=1000
LAB_GID=1000
